# SoftScale Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration (for backend application)
DB_NAME=talent_match_db
DB_USER=postgres
DB_PASSWORD=xxx
DB_HOST=localhost
DB_PORT=5432

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_DB=talent_match_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxx

# JWT Configuration
JWT_SECRET_KEY=xxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend Configuration
PYTHONUNBUFFERED=1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Configuration (comma-separated origins or * for all)
CORS_ORIGINS=*

# Embedding Model Configuration
EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDINGS_DIR=embeddings

# Frontend API Base URL (React requires REACT_APP_ prefix)
REACT_APP_API_BASE=http://127.0.0.1:8000
