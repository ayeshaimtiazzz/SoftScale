# SoftScale Environment Variables
# Copy this file to .env and update with your actual values

# Database Configuration (for backend application)
DB_NAME=talent_match_db
DB_USER=postgres
DB_PASSWORD=xxx
DB_HOST=127.0.0.1
DB_PORT=5433
# Seconds — avoids hanging forever if DB host/port is wrong
DB_CONNECT_TIMEOUT=10
# Set to 1 in environment for fastest API startup (models load on first use)
# SKIP_AI_WARMUP=1

# PostgreSQL Configuration (for Docker Compose)
POSTGRES_DB=talent_match_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=xxx

# JWT Configuration
JWT_SECRET_KEY=xxx
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Backend Configuration
PYTHONUNBUFFERED=1
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Sentiment analysis — SENTIMENT_FAST_MODE=true keeps responses under ~1 min on CPU (no per-request Llama).
# Backend warmup still preloads the sentiment Llama at start when SKIP_AI_WARMUP=0 (longer startup, no cold load).
# SENTIMENT_LLM_INPUT_MAX_CHARS=1200
# SENTIMENT_KEY_SIGNALS_MAX_TOKENS=80
# SENTIMENT_SUMMARY_MAX_TOKENS=90
# SENTIMENT_REPLY_MAX_TOKENS=100
# SENTIMENT_REPORT_LLM_MAX_TOKENS=250
# SENTIMENT_PARALLEL_CLASSIFIERS=true runs DistilBERT sentiment + intent in parallel (separate models).
# SENTIMENT_RESULT_CACHE_ENABLED=true buffers identical cleaned text in-process (TTL seconds).
# SENTIMENT_RESULT_CACHE_TTL_SECONDS=3600
# Deal conversation + DB: run backend/database/migration_deal_conversation_sentiment.sql on PostgreSQL when deploying.

# CORS Configuration (comma-separated origins)
# Includes both common local frontend ports used in this project.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001

# Embedding Model Configuration
EMBED_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDINGS_DIR=embeddings

# Frontend API Base URL (React requires REACT_APP_ prefix)
REACT_APP_API_BASE=http://127.0.0.1:8000/api
