{
  "compilerOptions": {
    "baseUrl": "src",
    "module": "esnext",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "allowJs": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "config": ["config/index.js"],
      "components/*": ["components/*"],
      "modules/*": ["modules/*"],
      "utils/*": ["utils/*"],
      "constants/*": ["constants/*"],
      "config/*": ["config/*"],
      "routes/*": ["routes/*"],
      "providers/*": ["providers/*"],
      "hooks/*": ["hooks/*"],
      "assets/*": ["assets/*"],
      "types/*": ["types/*"]
    }
  },
  "include": ["src"]
}

